# NorteShopMoz — Development Environment (TEMPLATE)
# Copie para .env e preencha com os seus valores:  cp .env.example .env
# O .env real NUNCA deve ser commitado (.gitignore já cobre).

# ── Cloudinary (imagens de produto) ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=TROQUE-ME
CLOUDINARY_API_KEY=TROQUE-ME
CLOUDINARY_API_SECRET=TROQUE-ME

# ── Base de Dados ────────────────────────────────────────────────────────────
# Porta 5434 no host (docker-compose mapeia 5434->5432)
DB_URL=jdbc:postgresql://localhost:5434/norteshopmoz
DB_NAME=norteshopmoz
DB_USER=postgres
DB_PASSWORD=postgres

# ── JWT ──────────────────────────────────────────────────────────────────────
# Gerar com: openssl rand -base64 48
JWT_SECRET=TROQUE-ME-openssl-rand-base64-48
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=2592000
# Inatividade máxima de sessão (minutos), imposta pelo SERVIDOR (Redis) — sem
# isto o "timeout de 30 min" era só do cliente e o cookie valia os 7 dias do
# JWT_EXPIRATION. Deve ser >= NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES.
SESSION_IDLE_TIMEOUT_MINUTES=30

# ── CORS ─────────────────────────────────────────────────────────────────────
# Em desenvolvimento inclua as duas formas do host local (http://localhost:3000
# e http://127.0.0.1:3000): abrir a loja por 127.0.0.1 com a API só a aceitar
# 'localhost' faz o browser bloquear TODAS as chamadas (o login falha com um
# erro de ligação que não existe).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Administrador ────────────────────────────────────────────────────────────
# Em desenvolvimento (docker-compose.yml) o admin nasce com
# admin@norteshopmoz.com / Admin@2026. O docker-compose.local-prod.yml corre
# com o perfil 'prod' e por isso EXIGE uma password própria (>=12 caracteres) —
# sem ela o arranque falha de propósito.
ADMIN_EMAIL=admin@norteshopmoz.com
ADMIN_PASSWORD=TROQUE-ME-12chars
# Proxies inversos fidedignos para X-Forwarded-For (vazio = nenhum).
TRUSTED_PROXIES=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Opcional em dev — sem chave, emails são apenas logados.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
APP_BASE_URL=http://localhost:3000
# Travão dos emails enviados por endpoints PÚBLICOS (register, forgot-password,
# resend-verification): o endereço de destino vem do pedido, sem exigir conta.
# Sem isto, uma lista de endereços queima a cota do fornecedor (e os clientes
# reais deixam de receber a confirmação do pedido) e suja a reputação do domínio.
# Só contam envios efetivos; com o Redis em baixo, falha aberto (a loja continua
# a registar clientes). Ver EmailThrottleService.
# MAIL_THROTTLE_ENABLED=true
# MAIL_MAX_PER_ADDRESS=3
# MAIL_ADDRESS_WINDOW_MINUTES=60
# MAIL_MAX_GLOBAL_PER_HOUR=500

# ── Login Social (OAuth) ─────────────────────────────────────────────────────
# O backend valida o `aud` do ID token do Google contra GOOGLE_CLIENT_ID e o
# debug_token do Facebook contra FACEBOOK_APP_SECRET. Os botões do frontend só
# aparecem se as variáveis NEXT_PUBLIC_* (abaixo) estiverem preenchidas — e o
# NEXT_PUBLIC_GOOGLE_CLIENT_ID TEM de ser IGUAL a GOOGLE_CLIENT_ID, senão o
# backend rejeita o token ("Token do Google inválido para esta aplicação").
GOOGLE_CLIENT_ID=TROQUE-ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TROQUE-ME
FACEBOOK_APP_ID=TROQUE-ME
FACEBOOK_APP_SECRET=TROQUE-ME

# ── Pagamentos ───────────────────────────────────────────────────────────────
# 'simulated' (padrão) ou 'live' (exige implementação real de PaymentGateway)
# Modo do gateway de pagamentos. Em desenvolvimento: simulated (não cobra).
# Em produção o gateway simulado NÃO é registado (perfil prod): os métodos
# online respondem 503 até existir uma integração real. Nunca confirme
# pagamentos sem cobrar — ver ProductionConfigGuard.
PAYMENTS_MODE=simulated
# Bulkhead das cobranças online: teto de cobranças SIMULTÂNEAS ao gateway. Cada
# uma ocupa uma thread do Tomcat durante a latência do gateway; sem teto, um
# gateway lento esgota as 200 threads e derruba a API inteira (não só o checkout).
PAYMENTS_MAX_CONCURRENT=8
# Tempo máximo de espera por uma vaga antes de responder 503 (segundos).
PAYMENTS_CHARGE_SLOT_TIMEOUT=10

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6381
# Timeout de cada comando ao Redis (1s por omissão). É o custo POR CHAMADA
# enquanto o Redis estiver pendurado — antes de o circuit breaker abrir.
# REDIS_TIMEOUT=1s

# ── Base de dados: pool JDBC ─────────────────────────────────────────────────
# O Hikari usa 10 ligações por omissão, contra 200 threads do Tomcat: uma base de
# dados lenta deixa as restantes threads à espera e a loja inteira responde 500.
# DB_POOL_SIZE=20
# DB_POOL_MIN_IDLE=5
# DB_POOL_CONNECTION_TIMEOUT_MS=10000

# ── Checkout público (POST /api/orders) ──────────────────────────────────────
# O checkout aceita convidados: cada pedido desconta stock real e envia email
# para o endereço indicado pelo cliente. O travão é por CONTACTO (email/telefone)
# — não por IP, porque em redes móveis (CGNAT) milhares de clientes partilham o
# mesmo IP e um limite por IP bloquearia vendas legítimas. Só contam pedidos
# CRIADOS com sucesso.
# ORDERS_THROTTLE_ENABLED=true
# ORDERS_MAX_PER_CONTACT=3
# ORDERS_CONTACT_WINDOW_MINUTES=60
# ORDERS_MAX_GLOBAL_PER_HOUR=1000
# Retenção: apaga pedidos TERMINAIS (entregues/cancelados) com mais de N dias.
# Por omissão 730 (~2 anos); 0 = desligado (mantém todo o histórico).
# ORDERS_RETENTION_DAYS=730

# ── Carrinhos de convidado ───────────────────────────────────────────────────
# Retenção por inatividade (dias) e TETO absoluto de linhas. O X-Guest-Id é
# escolhido pelo cliente, por isso sem teto um script cria centenas de milhares
# de carrinhos e enche o disco (disco cheio → PostgreSQL para → loja em baixo).
# GUEST_CART_RETENTION_DAYS=30
# GUEST_CART_MAX_COUNT=50000

# ── Agendador (@Scheduled) ───────────────────────────────────────────────────
# Nº de threads das tarefas periódicas (manutenção, sonda do Redis).
# SCHEDULER_POOL_SIZE=3

# ── Upload Local (fallback) ──────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Frontend (build time) ────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Login social no browser (build time). Têm de coincidir com o backend:
# NEXT_PUBLIC_GOOGLE_CLIENT_ID == GOOGLE_CLIENT_ID e
# NEXT_PUBLIC_FACEBOOK_APP_ID == FACEBOOK_APP_ID. Vazias → botões ocultos.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=TROQUE-ME.apps.googleusercontent.com
NEXT_PUBLIC_FACEBOOK_APP_ID=TROQUE-ME
# Duração da viagem do preloader de entrada (ms; mínimo 400; vazio = 2400).
# NEXT_PUBLIC_PRELOADER_MS=2400

# Contactos da loja (placeholders — configure os reais):
NEXT_PUBLIC_SUPPORT_PHONE=258XXXXXXXXX
NEXT_PUBLIC_SUPPORT_PHONE_DISPLAY=+258 XX XXX XXXX
NEXT_PUBLIC_SUPPORT_EMAIL=apoio@SEU-DOMINIO.com

# URL da API para as chamadas server-side do Next (route handlers/SSR).
API_INTERNAL_BASE_URL=http://localhost:8080
