# NorteShopMoz — Development Environment (TEMPLATE)
# Copie para .env e preencha com os seus valores:  cp .env.example .env
# O .env real NUNCA deve ser commitado (.gitignore já cobre).

# ── Cloudinary (imagens de produto) ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=TROQUE-ME
CLOUDINARY_API_KEY=TROQUE-ME
CLOUDINARY_API_SECRET=TROQUE-ME

# ── Base de Dados ────────────────────────────────────────────────────────────
# Porta 5434 no host (docker-compose mapeia 5434->5432)
DB_URL=jdbc:postgresql://localhost:5434/norteshopmoz
DB_NAME=norteshopmoz
DB_USER=postgres
DB_PASSWORD=postgres

# ── JWT ──────────────────────────────────────────────────────────────────────
# Gerar com: openssl rand -base64 48
JWT_SECRET=TROQUE-ME-openssl-rand-base64-48
JWT_EXPIRATION=604800
JWT_REFRESH_EXPIRATION=2592000

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Opcional em dev — sem chave, emails são apenas logados.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
APP_BASE_URL=http://localhost:3000

# ── Login Social (OAuth) ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=TROQUE-ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TROQUE-ME
FACEBOOK_APP_ID=TROQUE-ME
FACEBOOK_APP_SECRET=TROQUE-ME

# ── Pagamentos ───────────────────────────────────────────────────────────────
# 'simulated' (padrão) ou 'live' (exige implementação real de PaymentGateway)
PAYMENTS_MODE=simulated

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6381

# ── Upload Local (fallback) ──────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Frontend (build time) ────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Contactos da loja (placeholders — configure os reais):
NEXT_PUBLIC_SUPPORT_PHONE=258XXXXXXXXX
NEXT_PUBLIC_SUPPORT_PHONE_DISPLAY=+258 XX XXX XXXX
NEXT_PUBLIC_SUPPORT_EMAIL=apoio@SEU-DOMINIO.com
