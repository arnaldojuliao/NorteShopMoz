# NorteShopMoz - Production Environment (TEMPLATE)
# Copie para .env.prod e preencha com os valores reais.
# ⚠️ NUNCA commitar o .env.prod real! Use um gestor de segredos em produção
#    (Docker secrets, AWS Secrets Manager, etc.).

# DOMÍNIO E URLS BASE (configure com seu domínio real)
APP_BASE_URL=https://SEU-DOMINIO.com
NEXT_PUBLIC_APP_URL=https://SEU-DOMINIO.com
NEXT_PUBLIC_API_URL=https://api.SEU-DOMINIO.com
CORS_ALLOWED_ORIGINS=https://SEU-DOMINIO.com,https://www.SEU-DOMINIO.com

# BASE DE DADOS (gerar password: openssl rand -base64 24)
DB_NAME=norteshopmoz
DB_USER=norteshopmoz
DB_PASSWORD=TROQUE-ME
DB_URL=jdbc:postgresql://db:5432/norteshopmoz

# REDIS (gerar password: openssl rand -base64 24)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=TROQUE-ME

# JWT (gerar: openssl rand -base64 48)
JWT_SECRET=TROQUE-ME-openssl-rand-base64-48
JWT_EXPIRATION=604800
JWT_REFRESH_EXPIRATION=2592000

# CLOUDINARY (configure com suas credenciais reais)
CLOUDINARY_CLOUD_NAME=TROQUE-ME
CLOUDINARY_API_KEY=TROQUE-ME
CLOUDINARY_API_SECRET=TROQUE-ME

# EMAIL (Resend) - configure com sua chave real
RESEND_API_KEY=re_TROQUE-ME
RESEND_FROM=loja@SEU-DOMINIO.com

# LOGIN SOCIAL (Google/Facebook) - configure com suas credenciais reais
GOOGLE_CLIENT_ID=TROQUE-ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TROQUE-ME
FACEBOOK_APP_ID=TROQUE-ME
FACEBOOK_APP_SECRET=TROQUE-ME

# PAGAMENTOS
# 'simulated' — gera referência sem cobrar. 'live' exige implementação real
# de PaymentGateway; sem ela, pagamentos online devolvem 503 (app continua a arrancar).
PAYMENTS_MODE=simulated

# FRONTEND (build time)
NEXT_PUBLIC_API_URL=https://api.SEU-DOMINIO.com
NEXT_PUBLIC_APP_URL=https://SEU-DOMINIO.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=789356588167-e53fckmtsvdr8kj7i01obni2r5l9l068.apps.googleusercontent.com
NEXT_PUBLIC_FACEBOOK_APP_ID=1360065769581565
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=30

# CONTACTOS DA LOJA (aparecem no site)
NEXT_PUBLIC_SITE_URL=https://SEU-DOMINIO.com
NEXT_PUBLIC_SUPPORT_PHONE=258XXXXXXXXX
NEXT_PUBLIC_SUPPORT_PHONE_DISPLAY=+258 XX XXX XXXX
NEXT_PUBLIC_SUPPORT_EMAIL=apoio@SEU-DOMINIO.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacidade@SEU-DOMINIO.com
