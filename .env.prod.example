# NorteShopMoz - Production Environment (TEMPLATE)
# Copie para .env.prod e preencha com os valores reais.
# ⚠️ NUNCA commitar o .env.prod real! Use um gestor de segredos em produção
#    (Docker secrets, AWS Secrets Manager, etc.).

# DOMÍNIO E URLS BASE (configure com seu domínio real)
#
# NEXT_PUBLIC_API_URL tem de ser a MESMA origem da loja (same-origin): o nginx
# deste compose serve a API sob $APP_BASE_URL/api/... e só declara o domínio
# principal e o www (ver nginx/nginx.conf.template). Apontar para um subdomínio
# `api.` que não está no nginx/DNS deixava o login e o checkout a falhar na
# primeira montagem. Se quiser mesmo um subdomínio para a API, tem de o servir
# no nginx (server_name + DNS + certificado) antes de o usar aqui.
APP_BASE_URL=https://SEU-DOMINIO.com
NEXT_PUBLIC_APP_URL=https://SEU-DOMINIO.com
NEXT_PUBLIC_API_URL=https://SEU-DOMINIO.com
CORS_ALLOWED_ORIGINS=https://SEU-DOMINIO.com,https://www.SEU-DOMINIO.com

# BASE DE DADOS (gerar password: openssl rand -base64 24)
DB_NAME=norteshopmoz
DB_USER=norteshopmoz
DB_PASSWORD=TROQUE-ME
DB_URL=jdbc:postgresql://db:5432/norteshopmoz

# REDIS (gerar password: openssl rand -base64 24)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=TROQUE-ME

# JWT (gerar: openssl rand -base64 48)
JWT_SECRET=TROQUE-ME-openssl-rand-base64-48
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=2592000

# ADMINISTRADOR INICIAL (obrigatório — aqui NÃO existe password por omissão)
# Gerar: openssl rand -base64 24   (mínimo 12 caracteres)
# Sem ADMIN_PASSWORD o backend recusa arrancar com o perfil 'prod', para nunca
# ficar um admin com a password pública do repositório. Se a conta já existir na
# base de dados, o arranque também falha enquanto a password antiga for a de
# desenvolvimento — nesse caso elimine a conta e volte a arrancar.
ADMIN_EMAIL=admin@SEU-DOMINIO.com
ADMIN_PASSWORD=TROQUE-ME-openssl-rand-base64-24

# PROXY INVERSO (nginx do docker-compose.prod.yml)
# IP do nginx na rede nsm-prod-network: o backend só aceita
# X-Forwarded-For/X-Real-IP vindos deste endereço (impede forjar o IP do cliente
# e contornar rate limit/lockout). O nginx tem IP fixo 172.28.0.10 no compose;
# se mudar a sub-rede lá, mude também aqui.
TRUSTED_PROXIES=172.28.0.10

# CLOUDINARY (configure com suas credenciais reais)
CLOUDINARY_CLOUD_NAME=TROQUE-ME
CLOUDINARY_API_KEY=TROQUE-ME
CLOUDINARY_API_SECRET=TROQUE-ME

# EMAIL (Resend) - configure com sua chave real
RESEND_API_KEY=re_TROQUE-ME
RESEND_FROM=loja@SEU-DOMINIO.com

# LOGIN SOCIAL (Google/Facebook) - configure com suas credenciais reais
GOOGLE_CLIENT_ID=TROQUE-ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TROQUE-ME
FACEBOOK_APP_ID=TROQUE-ME
FACEBOOK_APP_SECRET=TROQUE-ME

# PAGAMENTOS
# 'simulated' — gera referência sem cobrar. 'live' exige implementação real
# de PaymentGateway; sem ela, pagamentos online devolvem 503 (app continua a arrancar).
PAYMENTS_MODE=simulated

# FRONTEND (build time)
# Mesma origem da loja (ver a nota no topo do ficheiro).
NEXT_PUBLIC_API_URL=https://SEU-DOMINIO.com
NEXT_PUBLIC_APP_URL=https://SEU-DOMINIO.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=789356588167-e53fckmtsvdr8kj7i01obni2r5l9l068.apps.googleusercontent.com
NEXT_PUBLIC_FACEBOOK_APP_ID=1360065769581565
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=30

# CONTACTOS DA LOJA (aparecem no site)
NEXT_PUBLIC_SITE_URL=https://SEU-DOMINIO.com
NEXT_PUBLIC_SUPPORT_PHONE=258XXXXXXXXX
NEXT_PUBLIC_SUPPORT_PHONE_DISPLAY=+258 XX XXX XXXX
NEXT_PUBLIC_SUPPORT_EMAIL=apoio@SEU-DOMINIO.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacidade@SEU-DOMINIO.com

# TLS / COOKIES
# Com APP_BASE_URL=https:// o deploy.sh (a) valida que os certificados existem,
# (b) gera a conf SSL a partir de nginx/nginx.conf.template e (c) recusa avançar
# sem eles. Defina APP_DOMAIN (se ficar vazio é derivado de APP_BASE_URL) e
# CERTBOT_CERTS se os certificados não estiverem em ./certbot/conf.
# O backend recusa arrancar com APP_COOKIE_SECURE=true e APP_BASE_URL não-https
# (o browser descarta os cookies de sessão e o login falha em silêncio).
APP_DOMAIN=loja.exemplo.com
CERTBOT_CERTS=./certbot/conf
CERTBOT_WWW=./certbot/www
# Deixe NGINX_CONF por definir: em HTTPS é gerado para ./nginx/.generated/default.conf
# NGINX_CONF=./nginx/conf.d/norteshopmoz.conf
APP_COOKIE_SECURE=true

# Inatividade máxima de uma sessão (minutos), imposta pelo SERVIDOR (Redis).
# Deve ser >= NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES para o cliente não expirar
# a sessão antes do servidor.
SESSION_IDLE_TIMEOUT_MINUTES=30

# MONITORIZAÇÃO (opcional — monitoring/docker-compose.monitoring.yml)
# Obrigatória para subir o Grafana (sem valor por omissão desde que a stack
# passou a fechar as portas em 127.0.0.1). Acesso por túnel SSH.
GRAFANA_ADMIN_PASSWORD=TROQUE-ME-password-forte

# BACKUPS
# Destino dos dumps. O deploy.sh grava um dump PRÉ-DEPLOY aqui antes de aplicar
# as migrações Flyway (que não têm rollback) e scripts/install-backup-cron.sh
# instala o backup diário + a verificação de integridade.
BACKUP_DIR=/backups/norteshop

# URL da API para as chamadas server-side do Next (route handlers/SSR).
# Dentro do docker-compose o servico da API chama-se "api"; deixar vazio para
# usar a URL publica (comportamento anterior).
API_INTERNAL_BASE_URL=http://api:8080
