# NorteShopMoz — valores de ambiente da API no Railway.
#
# O Railway usa os Variables do serviço (Variables → Raw Editor permite colar
# tudo de uma vez). Este ficheiro serve só de folha de rascunho para recolheres
# os valores ANTES de os colar no Railway. NUNCA o commits com valores reais.
#
# Valores com #, $, espaços ou aspas devem ficar entre aspas simples ('...').

# ── Railway ─────────────────────────────────────────────────────────────────
# A app escuta em PORT (o domínio gerado pelo Railway encaminha para esta porta).
PORT=8080

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → Connect → Session pooler (porta 5432, NÃO 6543).
# Cola a URI tal como está — a API converte para jdbc:postgresql:// sozinha.
# Se a password tiver @ ou caracteres especiais, copia a URI do painel
# (vem já codificada) ou codifica manualmente (@ → %40).
DB_URL=postgresql://postgres.CHANGE_ME:CHANGE_ME@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ── Upstash Redis (estado: refresh tokens, rate limit, idempotência) ────────
# Upstash só tem DB 0. Em Pricing/Settings → Eviction escolher "noeviction".
# Host SEM "https://" (ex.: open-treefrog-202452.upstash.io).
REDIS_HOST=CHANGE_ME.upstash.io
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=CHANGE_ME

# Opcional: SEGUNDA base Upstash só para cache (eviction allkeys-lru).
# Não apontar para o mesmo host da principal.
# CACHE_REDIS_HOST=CHANGE_ME.upstash.io
# CACHE_REDIS_PASSWORD=CHANGE_ME

# ── Segredos da API ─────────────────────────────────────────────────────────
# Gerar: openssl rand -base64 48
JWT_SECRET=
# Igual a API_PROXY_SECRET na Vercel. Gerar: openssl rand -hex 32
PROXY_TOKEN=
ADMIN_EMAIL=admin@CHANGE_ME
# Gerar: openssl rand -base64 24
ADMIN_PASSWORD=

# ── URLs públicos ───────────────────────────────────────────────────────────
# Deploy temporário sem domínio: usa o URL do serviço Railway (Settings →
# Networking → Generate Domain, formato <servico>.up.railway.app) e o da Vercel.
# APP_BASE_URL=https://norteshop.vercel.app
# CORS_ALLOWED_ORIGINS=https://norteshop.vercel.app
# PAYMENTS_WEBHOOK_URL=https://norteshop-api-production.up.railway.app/api/payments/webhook
# PAYMENTS_RETURN_URL=https://norteshop.vercel.app/pedidos
# Com domínio próprio (plano pago):
# APP_BASE_URL=https://seudominio.com
# CORS_ALLOWED_ORIGINS=https://seudominio.com,https://www.seudominio.com

# ── Email transacional (Resend). Sem chave, os emails ficam desativados. ────
# RESEND_API_KEY=
# RESEND_FROM=noreply@<o-teu-dominio>

# ── Cloudinary (uploads + avatares). Obrigatório em produção: o disco do ────
# Railway é efémero e os uploads de produtos desaparecem no deploy seguinte.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Login social (opcional) ─────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# ── Pagamentos PaySuite ─────────────────────────────────────────────────────
# PAYMENTS_MODE=live exige a chave abaixo (a API não arranca sem ela);
# PAYMENTS_MODE=simulated permite testar a loja sem cobranças online.
PAYMENTS_MODE=live
PAYMENTS_API_KEY=
PAYMENTS_WEBHOOK_SECRET=
